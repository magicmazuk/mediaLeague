# Copy to .env.local for local development (git-ignored), or set these in
# Vercel → Project → Settings → Environment Variables for the deployed site.

# The password for the sign-in page. Required on Vercel: the site stays locked until it's set.
# Locally, leave it empty to skip the sign-in page.
APP_PASSWORD=

# Optional extra secret mixed into session cookies. Changing it signs every device out.
SESSION_SECRET=

# Postgres connection string. Vercel's Neon integration sets this for you.
# Locally, leave it empty to use a built-in database stored in .data/pglite.
DATABASE_URL=
